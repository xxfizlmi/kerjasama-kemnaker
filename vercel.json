{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.2"
        }
    },
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/web/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/web/js/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/web/images/$1"
        },
        {
            "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|webp))$",
            "dest": "/web/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
